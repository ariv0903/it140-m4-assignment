
START hilow_game

    # Establish a valid guessing range.
    OUTPUT "Welcome to the higher/lower game, Bella!"

    INPUT lower_bound
    INPUT upper_bound

    WHILE lower_bound >= upper_bound
        OUTPUT "The lower bound must be less than the upper bound."
        INPUT lower_bound
        INPUT upper_bound
    END WHILE

    # Establish the number the player is trying to guess.
    SET target_number = RANDOM_INTEGER(lower_bound, upper_bound)

    # Play the game.
    OUTPUT "Great, now guess a number between the lower and upper bounds."
    INPUT guess

    # Validate the guess.
    WHILE guess < lower_bound OR guess > upper_bound
        OUTPUT "Please enter a number within the selected range."
        INPUT guess
    END WHILE

    # Continue until the correct number is guessed.
    WHILE guess != target_number

        IF guess < target_number THEN
            OUTPUT "Nope, too low."
        ELSE
            OUTPUT "Nope, too high."
        END IF

        OUTPUT "Guess another number."
        INPUT guess

        WHILE guess < lower_bound OR guess > upper_bound
            OUTPUT "Please enter a number within the selected range."
            INPUT guess
        END WHILE

    END WHILE

    OUTPUT "You got it!"

END hilow_game
